#!/usr/bin/env bash
# Fake libsecret `secret-tool` — the Linux twin of shims/security. File-backed at
# $SB_KEYCHAIN (one dir per sandbox "machine"), same file naming as the macOS fake
# (<service>__<account>), so the harness reads keys the same way on both platforms.
# The real keyring (and any D-Bus session) is never touched.
#   secret-tool store --label=L service S account A   (value on stdin)
#   secret-tool lookup service S account A            (exit 1 when absent)
#   secret-tool clear  service S account A
# The log has one line per call; a store's value is never logged: <redacted:stdin>
# (the real tool takes it on stdin only, so it can never appear on argv).
set -uo pipefail
: "${SB_KEYCHAIN:?}"; mkdir -p "$SB_KEYCHAIN"
op="${1:-}"; shift || true
s=""; a=""
args=("$@")
for ((i=0;i<${#args[@]};i++)); do
  case "${args[$i]}" in service) s="${args[$((i+1))]:-}";; account) a="${args[$((i+1))]:-}";; esac
done
if [ "$op" = store ]; then echo "secret-tool store $* <redacted:stdin>" >> "${SB_LOG:-/dev/null}"
else echo "secret-tool $op $*" >> "${SB_LOG:-/dev/null}"; fi
f="$SB_KEYCHAIN/${s}__${a}"
case "$op" in
  store)  [ "${SB_KEYCHAIN_DENY:-}" = 1 ] && { cat >/dev/null; exit 0; }   # simulate silent refusal
          cat > "$f"; printf '\n' >> "$f"; chmod 600 "$f"; exit 0;;
  lookup) [ -f "$f" ] || exit 1; cat "$f"; exit 0;;
  clear)  rm -f "$f"; exit 0;;
esac
exit 1
